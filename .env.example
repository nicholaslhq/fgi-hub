# ── Data Acquisition Mode ───────────────────────────────────────────────────
# "mock" (default in dev): frontend uses browser-side mock providers only.
# "prod": frontend calls the server API at /api/consensus/:market, which
#         fetches real data from external sources.
FGI_DATA_MODE=mock

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ── Cache ───────────────────────────────────────────────────────────────────
# TTL in seconds for cached consensus responses
FGI_CACHE_TTL=60
