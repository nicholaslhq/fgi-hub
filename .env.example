# ── Data Acquisition Mode ───────────────────────────────────────────────────
# "mock" (default in dev): frontend uses browser-side mock providers only.
# "prod": frontend calls the server API at /api/consensus/:market, which
#         fetches real data from external sources.
FGI_DATA_MODE=mock

# ── Cache ───────────────────────────────────────────────────────────────────
# TTL in seconds for cached consensus responses.
# Recommended range: 30–300 seconds. The default of 60 seconds balances data
# freshness against upstream request load. Sentiment sources typically update
# every few hours, so 60s keeps the dashboard responsive to manual refreshes
# while preventing request storms that could trigger external rate limits.
# Increase toward 300 for lighter upstream load; decrease toward 30 for fresher
# data at the cost of more external requests.
FGI_CACHE_TTL=60
